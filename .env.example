# The database to expose. The only required setting.
DATABASE_URL=postgres://user:password@host:5432/dbname

# The admin account. Leave unset to create it in the dashboard on first visit.
# When set, the account is created at startup if no account exists yet.
# P2M_ADMIN_USERNAME=admin
# P2M_ADMIN_PASSWORD=

# PORT=3333
# HOST=0.0.0.0
# P2M_DATA_DIR=./data            # accounts, keys, custom tools and logs live here (SQLite)
# P2M_MAX_ROWS=1000              # row cap on every result
# P2M_QUERY_TIMEOUT_MS=15000     # statement timeout; keeps a shorter DB limit, 0 adds no limit
# P2M_LOG_RETENTION_DAYS=30      # 0 keeps logs forever

# ── Deploying with a domain (docker-compose.yml; install.sh writes these) ─────

# The address clients reach the server at, when it sits behind a proxy or a
# domain. Used for the URLs the server and the dashboard show.
# P2M_PUBLIC_URL=https://mcp.example.com

# Require this code to create the first account in the dashboard. The startup
# log prints its link. Unset: a random code is generated on each startup.
# Set a stable code with: openssl rand -hex 16
# P2M_SETUP_TOKEN=

# The domain Caddy serves and obtains a certificate for, and the Compose
# profile that starts Caddy.
# P2M_DOMAIN=mcp.example.com
# COMPOSE_PROFILES=tls

# The interface port 3333 is published on (default 127.0.0.1). This keeps it off the public
# interface when Caddy (or your own proxy) is the way in.
# P2M_BIND=127.0.0.1
